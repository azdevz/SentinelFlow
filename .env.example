# ==============================================================================
# SentinelFlow AI — Environment Configuration Template
# ==============================================================================

# --- AI Model Provider ---
# Set at least one AI key (OpenAI or Gemini)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Linear Integration ---
# Personal API Key (Settings -> Account -> Security & Access -> Personal API Keys)
LINEAR_API_KEY=
# Linear Team Key (e.g. AK, ENG, DEV, PROD)
LINEAR_TEAM_KEY=AK
# Linear Project Name (e.g. SentinelFlow)
LINEAR_PROJECT_NAME=SentinelFlow

# --- Slack Integration ---
# Slack Incoming Webhook URL (https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=

# --- GitHub Integration ---
# GitHub Token (automatically provided in GitHub Actions as ${{ secrets.GITHUB_TOKEN }})
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_PULL_REQUEST_NUMBER=
GITHUB_COMMIT_SHA=

# --- SentinelFlow Policy Configuration ---
# Confidence threshold for automatic Linear issue creation (0.0 to 1.0)
SENTINELFLOW_AUTO_TICKET_THRESHOLD=0.90
# Alert on dependency vulnerabilities with minimum severity: low | moderate | high | critical
SENTINELFLOW_SECURITY_SEVERITY_LEVEL=high
